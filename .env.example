# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=el-xxxxxxxxxxxxxxxxxxxx

# ── Optional API keys ─────────────────────────────────────────────────────────
VAPI_API_KEY=vapi-xxxxxxxxxxxxxxxxxxxx
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Model + voice settings ────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
WAKE_WORD=jarvis

# ── User identity ─────────────────────────────────────────────────────────────
# Spoken name when asked "what's my name?" — overrides the default in jarvis.json
# USER_NAME=Valentine

# ── Weather ───────────────────────────────────────────────────────────────────
# Default city for weather queries (City,CountryCode)
# OPENWEATHER_DEFAULT_CITY=Monrovia,LR

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false

# ── File operations ───────────────────────────────────────────────────────────
# Where to create new files when the folder isn't found on disk.
# One of: documents | desktop | downloads | home  (default: documents)
# JARVIS_DEFAULT_CREATE_PARENT=documents

# ── Browser automation ────────────────────────────────────────────────────────
# Set false to disable the snapshot-driven LLM element picker and force the
# legacy text/selector chain in browser_automation. Useful for cost control,
# offline debugging, or rolling back if Haiku misbehaves on a specific page.
JARVIS_BROWSER_USE_LLM_PICKER=true

# ── OCR / screen reader ───────────────────────────────────────────────────────
# Full path to tesseract.exe — set this if "tesseract -v" works in PowerShell
# but JARVIS still says Tesseract not found (GUIs often inherit a shorter PATH).
# Get the path with:  where tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
