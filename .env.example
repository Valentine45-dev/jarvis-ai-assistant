ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
VAPI_API_KEY=vapi-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514
WAKE_WORD=jarvis
DEBUG=false

# Where to put new relative paths when the first folder segment is not found on disk
# (file_operation). One of: documents | desktop | downloads | home (default: documents)
# JARVIS_DEFAULT_CREATE_PARENT=documents

# Optional: full path to tesseract.exe (OCR / read screen). Set this if "tesseract -v"
# works in PowerShell but JARVIS still says Tesseract not found — GUIs often inherit a
# shorter PATH than an interactive shell. Get the path with:  where tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
