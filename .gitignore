# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

.cursor/
.claude/

assets/reference/

# Virtual environments
.venv

# Environment secrets
.env
config/jarvis.json

# Session data (local only — never commit)
data/session_history.db
data/session_history.db-shm
data/session_history.db-wal
data/session_history.json
data/response_history.jsonl
data/memory.jsonl
# Per-step latency telemetry — rewritten on every successful workflow run.
# Machine-specific noise that would create constant diff churn; the rolling
# avg surfaces in the UI either way once a workflow has been run locally.
data/workflow_metrics.json

# Scheduler last-fire marks (R3-8/R3-9) — local runtime state, per machine.
data/scheduler_state.json

# User's workflow definitions — runtime state JARVIS rewrites on every
# create/rename/delete/enable/disable. Tracking it meant the file showed
# perpetually unstaged; it's local user data (like the entries above), not
# source. The app recreates it on first run when absent.
data/workflows.json

# Runtime logs (local only — churn on every run)
logs/

# Document-creation output samples — generated by the document_creation
# feature during testing. Same shape as logs/: churn on every run, bloat
# history. Output one-offs you want to keep go elsewhere (e.g. attach to
# a PR or copy out to ~/Documents).
docs/

# Local working notes — kept on disk, not tracked.
context.md
audit.md
